generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  name         String
  email        String?   @default("")
  role         String
  team         String
  playerRef    String?
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Player {
  id           String    @id @default(uuid())
  playerId     String    @unique
  name         String
  team         String
  jerseyNumber Int
  position     String    @default("All-Rounder")
  active       Boolean   @default(true)
  photoUrl     String?   @default("")
  dateOfBirth  DateTime?
  bloodGroup   String?   @default("Unknown")
  heightCm     Float?
  weightKg     Float?
  contactInfo  Json?     @default("{}")
  userRef      String?
  notes        String?   @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([team, jerseyNumber])
  @@map("players")
}

model AttendanceSession {
  id            String    @id @default(uuid())
  team          String
  date          String
  sessionLabel  String
  status        String    @default("DRAFT")
  notes         String?   @default("")
  totalEligible Int       @default(0)
  totalPresent  Int       @default(0)
  totalAbsent   Int       @default(0)
  totalLate     Int       @default(0)
  totalExcused  Int       @default(0)
  recordedBy    String
  updatedBy     String?
  finalizedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([team, date, sessionLabel])
  @@map("attendancesessions")
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  session    String
  player     String
  team       String
  date       String
  status     String
  notes      String?  @default("")
  recordedBy String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([session, player])
  @@map("attendancerecords")
}

model Match {
  id                          String   @id @default(uuid())
  team                        String
  opponent                    String
  competition                 String
  venue                       String
  matchDate                   DateTime
  squadSize                   Int      @default(15)
  eligibilityMinAttendancePct Float    @default(75)
  status                      String   @default("SCHEDULED")
  result                      Json?    @default("{}")
  squadRef                    String?
  createdBy                   String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("matches")
}

model MatchSquad {
  id              String    @id @default(uuid())
  match           String    @unique
  team            String
  selectedPlayers Json      @default("[]")
  reservePlayers  Json      @default("[]")
  status          String    @default("DRAFT")
  maxSquadSize    Int
  coachNotes      String?   @default("")
  finalizedBy     String?
  finalizedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("matchsquads")
}

model Announcement {
  id         String   @id @default(uuid())
  team       String   @default("ALL")
  title      String
  message    String
  category   String   @default("GENERAL")
  isUrgent   Boolean  @default(false)
  published  Boolean  @default(true)
  author     String
  authorName String   @default("Coaching Staff")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("announcements")
}

model Achievement {
  id          String   @id @default(uuid())
  title       String
  year        Int
  event       String
  result      String
  description String?  @default("")
  image       String?  @default("")
  category    String   @default("COMBINED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("achievements")
}

model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  caption   String?  @default("")
  imageUrl  String
  category  String   @default("Action")
  team      String   @default("ALL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("galleryitems")
}

model AuditLog {
  id            String   @id @default(uuid())
  actor         String?
  actorUsername String   @default("system")
  actorRole     String   @default("SYSTEM")
  team          String   @default("ALL")
  action        String
  entity        String
  entityId      String?  @default("")
  details       Json?    @default("{}")
  ipAddress     String?  @default("")
  timestamp     DateTime @default(now())

  @@map("auditlogs")
}

model GroundActivity {
  id            String   @id @default(uuid())
  team          String
  date          String
  title         String
  focusArea     String   @default("General Ground Training")
  activities    Json     @default("[]")
  coachNotes    String?  @default("")
  sessionTime   String   @default("MORNING")
  intensity     String   @default("HIGH")
  createdBy     String
  createdByName String   @default("Head Coach")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("groundactivities")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?  @default("")
  subject   String
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contactmessages")
}

model TutorialVideo {
  id           String   @id @default(uuid())
  title        String
  description  String
  level        String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  category     String   @default("RULES") // RULES | CHASING | DEFENSE | RUNNING | POLE_DIVING | CHAIN_KHO
  videoUrl     String
  thumbnailUrl String   @default("")
  duration     String   @default("5:00")
  skills       Json     @default("[]")
  order        Int      @default(0)
  views        Int      @default(0)
  likes        Int      @default(0)
  author       String   @default("Coaching Staff")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tutorialvideos")
}

model MatchHighlight {
  id              String   @id @default(uuid())
  title           String
  description     String
  tournament      String   @default("National Championship")
  team1           String   @default("Boys Squad")
  team2           String   @default("Opponent")
  score1          Int      @default(0)
  score2          Int      @default(0)
  division        String   @default("BOYS") // BOYS | GIRLS | COMBINED
  matchDate       DateTime @default(now())
  venue           String   @default("National Sports Complex")
  videoUrl        String
  thumbnailUrl    String   @default("")
  duration        String   @default("10:00")
  mvpPlayer       String   @default("")
  featuredPlayers Json     @default("[]")
  keyMoments      Json     @default("[]")
  views           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("matchhighlights")
}

model PlayerPerformance {
  id                  String   @id @default(uuid())
  playerId            String   @unique
  name                String
  jerseyNumber        Int
  team                String   @default("BOYS") // BOYS | GIRLS
  position            String   @default("All-Rounder")
  photoUrl            String?  @default("")
  matchesPlayed       Int      @default(0)
  matchesParticipated Int      @default(0)
  defendersEliminated Int      @default(0) // outs taken as chaser
  successfulDefenses  Int      @default(0) // turns successfully defended
  defenseTimeSec      Int      @default(0) // total seconds of defense
  diveSuccessPct      Float    @default(80.0)
  turnAccuracyPct     Float    @default(85.0)
  rating              Float    @default(8.5)
  form                Json     @default("[\"W\",\"W\",\"W\",\"W\",\"W\"]")
  recentMatchStats    Json     @default("[]")
  isVerified          Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([team, jerseyNumber])
  @@map("playerperformances")
}

model TeamPerformance {
  id                 String   @id @default(uuid())
  team               String   @unique // BOYS | GIRLS
  matchesPlayed      Int      @default(0)
  won                Int      @default(0)
  lost               Int      @default(0)
  tied               Int      @default(0)
  winPercentage      Float    @default(0.0)
  ranking            Int      @default(1)
  totalPointsScored  Int      @default(0)
  pointsConceded     Int      @default(0)
  history            Json     @default("[]")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("teamperformances")
}

model PracticeTask {
  id              String   @id @default(uuid())
  name            String
  description     String
  instructions    Json     @default("[]")
  category        String   @default("SPEED_AGILITY") // RUNNING | SPEED_AGILITY | DEFENSIVE | CHASING | POLE_DIVING | CHAIN_KHO | REACTION_TIME | TEAM_COORDINATION
  difficulty      String   @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  durationMinutes Int      @default(15)
  skillsDeveloped Json     @default("[]")
  targetReps      String   @default("3 sets x 10 reps")
  restPeriodSec   Int      @default(45)
  intensity       String   @default("HIGH") // LOW | MEDIUM | HIGH | EXTREME
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("practicetasks")
}

model UserPracticeLog {
  id              String   @id @default(uuid())
  userIdentifier  String   // username, player id, or client token
  taskId          String
  date            String   // YYYY-MM-DD
  completed       Boolean  @default(true)
  durationMinutes Int      @default(15)
  createdAt       DateTime @default(now())

  @@unique([userIdentifier, taskId, date])
  @@map("userpracticelogs")
}

model TutorialProgress {
  id             String   @id @default(uuid())
  userIdentifier String
  tutorialId     String
  completed      Boolean  @default(true)
  completedAt    DateTime @default(now())

  @@unique([userIdentifier, tutorialId])
  @@map("tutorialprogresses")
}

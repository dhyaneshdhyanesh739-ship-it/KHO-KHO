{
  "name": "kho-kho-arena",
  "version": "1.0.0",
  "description": "KHO-KHO ARENA — Professional Sports Team Management System for Boys & Girls Kho-Kho Teams",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npx prisma generate && npm --prefix client run build",
    "start": "node server/src/server.js",
    "test": "npm --prefix server run test",
    "seed": "npm --prefix server run seed"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "kho-kho",
    "sports-management",
    "attendance",
    "mern",
    "threejs"
  ],
  "author": "Kho-Kho Arena Team",
  "license": "ISC"
}
